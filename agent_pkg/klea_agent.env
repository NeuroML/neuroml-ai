# Klea Agent model defaults (env file is optional -- shell env vars also work)
# Each <ROLE> maps to the env var KLEA_AGENT_<ROLE>_MODEL.
# Required roles: chat, plan.  Guard is optional (empty = skipped).
KLEA_AGENT_CHAT_MODEL=ollama:qwen3:0.6b
KLEA_AGENT_PLAN_MODEL=ollama:qwen3:0.6b
#KLEA_AGENT_GUARD_MODEL=ollama:llama-guard3:1b
